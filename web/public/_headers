# Security headers for hosts that support them (Netlify, Cloudflare Pages,
# or any reverse proxy). GitHub Pages ignores this file, which is why the CSP is
# ALSO delivered via a meta tag in index.html.
#
# The header-only directives below cannot be expressed in a meta tag at all, so
# hosting behind a platform that honours this file is strictly more secure than
# GitHub Pages.

/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; worker-src 'self' blob:; manifest-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), serial=(), hid=(), bluetooth=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin

# Fingerprinted assets are immutable.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# index.html must never be cached: a stale frontend means acquisition semantics
# that no longer match the manifest it writes.
/index.html
  Cache-Control: no-cache, must-revalidate
